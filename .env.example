# Copy this file to .env before running Docker Compose.
# Both values are intentionally empty. Docker Compose refuses to start until
# you replace them with different, strong passwords in your local .env file.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Database settings
MARIADB_IMAGE_VERSION=11.4.12
DB_HOST=database
DB_PORT=3306
DB_NAME=baby_record
DB_USERNAME=baby

# Public Web port. SERVER_HOST_PORT is only used by docker-compose.dev.yml.
SERVER_HOST_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8088

# Keep this true behind HTTPS. Set false only for local HTTP development.
APP_SECURE_COOKIE=true
APP_AUTH_SESSION_DAYS=180
APP_AUTH_CREATION_RECOVERY_MINUTES=30
# Comma-separated origins. Add http://localhost:5173 and
# http://127.0.0.1:5173 when running the Vite development server.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8088,http://127.0.0.1:8088
APP_TIMEZONE=Asia/Shanghai

# Server-side AI integration. Never expose this key through VITE_* variables.
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ATTEMPT_TIMEOUT_SECONDS=90
DEEPSEEK_TOTAL_TIMEOUT_SECONDS=90
AI_STREAM_HEARTBEAT_INTERVAL_MS=10000
# Business SSE (dashboard sync) heartbeat. Keep below any proxy idle timeout.
REALTIME_HEARTBEAT_INTERVAL_MS=20000
